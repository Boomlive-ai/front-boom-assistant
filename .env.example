# Copy this file to .env and fill in the real values.
# .env is git-ignored; this template is committed so the names are documented.

# Hocalwire session token, one per story language. The Create Feed button picks
# the one that matches the language the story was generated in, so the editor
# never types a token into the page.
SESSION_ID_EN=
SESSION_ID_HI=
SESSION_ID_BN=

# Upstream services. Both already default to the deployed BOOM VPS URLs in
# server.js, so you only need these to point at something else.
# GENERATE_API=http://127.0.0.1:8000/generate
# CREATE_FEED_API=https://microservices.coolify.vps.boomlive.in/api/hocalwire/createFeedV2

# Monthly Report page. Defaults to the local FastAPI service; set it to the
# deployed URL once the VPS has the /boom-research/report route.
# REPORT_API=http://127.0.0.1:8000/boom-research/report
# The month dropdown's list. Defaults to REPORT_API with /report → /months.
# The database login is NOT set here: it lives in the FastAPI service's .env.
# REPORT_MONTHS_API=http://127.0.0.1:8000/boom-research/months

# PORT=3000
# BASE_PATH=/front-boom-assistant

# Hocalwire section the feed is filed under. Defaults to 796 if left unset.
FEED_CATEGORY_ID=796
