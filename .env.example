# Copy this file to .env and fill in the real values.
# .env is git-ignored; this template is committed so the names are documented.
#
# server.js has no addresses, tokens or IDs written in it: every value below
# comes from .env (on your computer) or from the server's environment variables
# (Coolify / Docker — the Docker image never contains a .env). A missing one is
# listed when the server starts, and the page that needs it shows an error
# naming it. Restart the server after changing anything here.

# ---------- Credentials ----------
# Hocalwire session token, one per story language. The Create Feed button picks
# the one that matches the language the story was generated in, so the editor
# never types a token into the page. Required for Create Feed.
SESSION_ID_EN=
SESSION_ID_HI=
SESSION_ID_BN=

# Hocalwire section the feed is filed under. Required for Create Feed.
FEED_CATEGORY_ID=796

# ---------- Upstream services (all required) ----------
# The story generator (main page).
GENERATE_API=https://boom-assistant.vps.boomlive.in/generate
# Hocalwire createFeedV2 (Create Feed button).
CREATE_FEED_API=https://microservices.coolify.vps.boomlive.in/api/hocalwire/createFeedV2
# Report and topic pages: a report for any From–To dates, built from the
# research database. The deployed VPS has no /boom-research/range-report route
# yet, so this points at the FastAPI service on your own computer for now;
# once it does, use
# https://boom-assistant.vps.boomlive.in/boom-research/range-report
REPORT_RANGE_API=http://127.0.0.1:8000/boom-research/range-report
# The dates the database covers, shown under the date pickers. Optional: when
# left out it is REPORT_RANGE_API with /range-report → /dates. The database
# login is NOT set here: it lives in the FastAPI service's own .env.
# REPORT_DATES_API=http://127.0.0.1:8000/boom-research/dates

# ---------- Make a Story (report page) ----------
# Hocalwire createFeedV2, which turns a report into a story in the CMS.
# Required for the Make a Story button.
REPORT_STORY_API=https://www.boomlive.in/dev/h-api/createFeedV2
# Credentials, like the session IDs above: the key sent in the request's S-id
# header, and the session token put into the body's sessionId. The API needs
# both — without the session token it answers 401.
REPORT_STORY_SID=
REPORT_STORY_SESSION_ID=
# Optional: the CMS section report stories are filed under. Left out, the
# story is sent with categoryId "" (as in the sample payload).
# REPORT_STORY_CATEGORY_ID=

# ---------- Server (optional) ----------
# Defaults: port 3000, and also served under /front-boom-assistant/.
# BASE_PATH= (empty) serves the app at the root address only.
# PORT=3000
# BASE_PATH=/front-boom-assistant
